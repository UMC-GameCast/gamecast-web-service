# GameCast Web Service Environment Variables

# API Server URL (서버의 기본 URL, /api 경로는 코드에서 추가됨)
# 개발 환경에서는 프록시를 사용하므로 빈 문자열로 설정
VITE_API_BASE_URL=

# Socket.IO Server URL  
# 개발 환경에서는 프록시를 사용하므로 빈 문자열로 설정
VITE_SOCKET_URL=

# Environment Mode
# development | staging | production  
VITE_MODE=development

# Debug Mode (개발 환경에서 디버깅용)
# VITE_DEBUG=false